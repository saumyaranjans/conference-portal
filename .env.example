NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in. Comma-separated Supabase provider ids to offer on the
# sign-in and registration pages, e.g. "google,azure" ("azure" is Microsoft).
# A provider listed here MUST also be enabled in the Supabase dashboard —
# signInWithOAuth navigates away from the app, so a provider that is listed but
# not configured lands the visitor on a raw error page. Leave unset to show no
# social buttons at all.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Cloudflare Turnstile site key. The captcha widget renders only when this is
# set; leave it blank and the auth forms behave exactly as before. Must be live
# in the browser BEFORE enabling captcha verification in Supabase, or every
# sign-in fails in the gap between the two changes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Registration payments (ICICI Bank).
#
# Leave PAYMENT_PROVIDER unset until the merchant account is live: the
# registration page then still collects everything and tells the delegate that
# online payment is not open yet, rather than offering a button that fails at
# the bank. Set it to whichever product ICICI onboarded the conference to, and
# fill in that block's credentials — a half-filled block counts as unconfigured.
#
#   icici_eazypay   ICICI's own collections platform
#   icici_ccavenue  the CCAvenue aggregator, ICICI-fronted
PAYMENT_PROVIDER=

# --- if PAYMENT_PROVIDER=icici_eazypay ---
ICICI_EAZYPAY_MERCHANT_ID=
ICICI_EAZYPAY_SUB_MERCHANT_ID=
ICICI_EAZYPAY_ENCRYPTION_KEY=
ICICI_EAZYPAY_ENDPOINT=

# --- if PAYMENT_PROVIDER=icici_ccavenue ---
ICICI_CCAVENUE_MERCHANT_ID=
ICICI_CCAVENUE_ACCESS_CODE=
ICICI_CCAVENUE_WORKING_KEY=
ICICI_CCAVENUE_ENDPOINT=
