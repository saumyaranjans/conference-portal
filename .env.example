NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in. Comma-separated Supabase provider ids to offer on the
# sign-in and registration pages, e.g. "google,azure" ("azure" is Microsoft).
# A provider listed here MUST also be enabled in the Supabase dashboard —
# signInWithOAuth navigates away from the app, so a provider that is listed but
# not configured lands the visitor on a raw error page. Leave unset to show no
# social buttons at all.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Cloudflare Turnstile site key. The captcha widget renders only when this is
# set; leave it blank and the auth forms behave exactly as before. Must be live
# in the browser BEFORE enabling captcha verification in Supabase, or every
# sign-in fails in the gap between the two changes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
